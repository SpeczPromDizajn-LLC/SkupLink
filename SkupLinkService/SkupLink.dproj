    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2_Win64)'!=''">
        <BT_BuildType>Debug</BT_BuildType>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="uWinService.pas">
            <Form>SkupLinkService</Form>
            <DesignClass>TService</DesignClass>
        </DCCReference>
        <DCCReference Include="Common.pas"/>
        <DCCReference Include="uAppConfig.pas"/>
        <DCCReference Include="uAuth.pas"/>
        <DCCReference Include="uHistoryStore.pas"/>
        <DCCReference Include="uShutdownWatch.pas"/>
        <DCCReference Include="uSnmpOids.pas"/>
        <DCCReference Include="uUpsModels.pas"/>
        <DCCReference Include="uApiModels.pas"/>
        <DCCReference Include="uSnmpUpsClient.pas"/>
        <DCCReference Include="uNetInterfaces.pas"/>
        <DCCReference Include="uUdpDiscover.pas"/>
        <DCCReference Include="uHttpApiServer.pas"/>
